rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Public read, only account owner can write
    match /users/{userId} {
      allow read: if true;
      allow create, update, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Matches: Public read, authenticated users can create/join
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.host.uid == request.auth.uid);
    }
  }
}
